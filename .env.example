# ============================================
# CONFIGURACIÓN DE DATABRICKS MCP
# ============================================
# 
# Copia este archivo como .env y completa tus credenciales:
#   cp .env.example .env
#
# IMPORTANTE: Nunca subas el archivo .env a git
# ============================================

# URL de tu workspace de Databricks (sin https://)
# Tu workspace: dbc-185110ea-a5be.cloud.databricks.com
DATABRICKS_HOST=dbc-185110ea-a5be.cloud.databricks.com

# Personal Access Token de Databricks
# Para generar uno:
# 1. Ve a tu workspace de Databricks
# 2. Click en tu usuario (esquina superior derecha)
# 3. Selecciona "User Settings"
# 4. Ve a "Access tokens" o "Developer" > "Access tokens"
# 5. Click en "Generate new token"
DATABRICKS_TOKEN=

# ============================================
# PARA CONEXIÓN NATIVA (streamable-http)
# ============================================
# Si usas la opción "databricks-native" en mcp.json,
# también necesitas configurar estos valores directamente
# en el archivo .cursor/mcp.json:

# TU_WORKSPACE_HOSTNAME: tu hostname completo (ej: adb-123456789012.azuredatabricks.net)
# CATALOG_NAME: nombre de tu catálogo en Unity Catalog
# SCHEMA_NAME: nombre del schema que quieres acceder
# TU_PERSONAL_ACCESS_TOKEN: tu token de acceso personal
