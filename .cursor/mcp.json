{
  "mcpServers": {
    "databricks-native": {
      "type": "streamable-http",
      "url": "https://dbc-185110ea-a5be.cloud.databricks.com/api/2.0/mcp/functions/risk_analyst/lfp",
      "headers": {
        "Authorization": "Bearer <TU_PERSONAL_ACCESS_TOKEN>"
      },
      "note": "Databricks Unity Catalog - Conexión nativa via Streamable HTTP"
    },
    "databricks-docker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABRICKS_HOST",
        "-e",
        "DATABRICKS_TOKEN",
        "ghcr.io/revodatanl/databricks-mcp-server:latest"
      ],
      "env": {
        "DATABRICKS_HOST": "${env:DATABRICKS_HOST}",
        "DATABRICKS_TOKEN": "${env:DATABRICKS_TOKEN}"
      },
      "note": "Databricks MCP Server - Requiere Docker Desktop y archivo .env configurado"
    }
  }
}
